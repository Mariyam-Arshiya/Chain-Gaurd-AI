# ChainGuard AI — environment configuration (all optional; defaults are offline-safe)
# Copy to .env and adjust as needed.

# Server
CG_HOST=127.0.0.1
CG_PORT=8000

# Storage locations (relative to repo root)
CG_STORAGE_DIR=backend/storage
CG_DATA_DIR=data

# Upload limits
CG_UPLOAD_MAX_MB=250
CG_DEMO_MAX_RECORDS=1000000

# Analysis defaults
CG_TEMPORAL_WINDOW_SECONDS=30
CG_MAX_HOPS=2
CG_RANDOM_SEED=42

# Modes
CG_DEMO_MODE=1
